APP_NAME=CleanLoop
APP_ENV=development
DEBUG=true

DATABASE_URL=postgresql+psycopg://cleanloop:cleanloop_password@postgres:5432/cleanloop

POSTGRES_DB=cleanloop
POSTGRES_USER=cleanloop
POSTGRES_PASSWORD=change_me

JWT_SECRET_KEY=change_me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

STORAGE_TYPE=minio
STORAGE_PATH=/app/storage

MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=cleanloop_minio
MINIO_SECRET_KEY=change_me
MINIO_BUCKET=cleanloop

MAX_UPLOAD_SIZE_MB=10

DEDUPLICATION_RADIUS_METERS=20
IMAGE_SIMILARITY_THRESHOLD=0.85

AI_PROVIDER=mock

CORS_ORIGINS=http://localhost:3000
