# Application Settings
APP_NAME=EchoCrew
ENVIRONMENT=development
LOG_LEVEL=info
DEBUG=true

# Server Settings
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Security & Authentication
SECRET_KEY=change_this_super_secret_key_for_dev_only
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database Settings
POSTGRES_USER=echocrew
POSTGRES_PASSWORD=echocrew_pass
POSTGRES_DB=echocrew_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://echocrew:echocrew_pass@localhost:5432/echocrew_db

# MinIO / Object Storage Settings
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=echocrew-storage

# AI & Spatial Cluster Settings
AI_PROVIDER=local
SPATIAL_DEDUPLICATION_RADIUS_METERS=500

# Local Storage Directory
STORAGE_DIR=./storage
